# ============================================================
# Healthcare Claims Management — Environment Variables Template
#
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
#
# Generate JWT_SECRET_KEY with: openssl rand -hex 32
# ============================================================

# ── Backend ─────────────────────────────────────────────────
# Full pyodbc connection string.
# Use DRIVER={ODBC Driver 17 for SQL Server} or {ODBC Driver 18 for SQL Server}
DATABASE_URL=DRIVER={ODBC Driver 17 for SQL Server};Server=localhost\sqlexpress;Database=HealthCareDB;Trusted_Connection=yes;

# JWT — generate a 256-bit secret: openssl rand -hex 32
JWT_SECRET_KEY=REPLACE_WITH_256_BIT_RANDOM_HEX_STRING
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=8

# CORS — JSON array of allowed frontend origins
CORS_ORIGINS=["http://localhost:5173"]

# File storage (relative to the directory where uvicorn is started)
UPLOAD_DIR=../uploads

# Application mode: "development" enables /docs; "production" disables it
ENV=development

# ── AI Service (Optional — endpoints return 503 when not configured) ────────
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_OPENAI_KEY
OPENAI_MODEL=gpt-4o

# Azure OpenAI (only required when LLM_PROVIDER=azure)
AZURE_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com/
AZURE_API_KEY=REPLACE_WITH_AZURE_API_KEY
AZURE_DEPLOYMENT=gpt-4o

# Embedding model
EMBEDDING_PROVIDER=openai

# Vector store persistence directory (relative to project root)
CHROMA_PERSIST_DIR=../ai_data/chroma

# ── Frontend (Vite env vars — MUST be prefixed with VITE_) ──────────────────
VITE_API_BASE_URL=http://localhost:8000

# ── PropelIQ Framework ───────────────────────────────────────────────────────
# Required only for PropelIQ AI-powered development commands (/create-spec, etc.)
CONTEXT7_API_KEY=REPLACE_WITH_YOUR_CONTEXT7_KEY
